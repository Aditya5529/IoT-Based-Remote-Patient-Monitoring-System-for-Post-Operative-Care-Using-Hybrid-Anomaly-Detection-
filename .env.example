# ----------------------------------------
# Backend Environment Variables
# ----------------------------------------
# PostgreSQL Database URL
DATABASE_URL=postgresql://rpm_user:rpm_password@localhost:5432/rpm_db
# In docker-compose, this is postgresql://rpm_user:rpm_password@db:5432/rpm_db

# Redis URL for queue/caching
REDIS_URL=redis://localhost:6379/0
# In docker-compose, this is redis://redis:6379/0

# JWT Security
SECRET_KEY=supersecretkeyForDevelopmentOnly
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS Origins (JSON array string)
ALLOWED_ORIGINS=["http://localhost","http://localhost:5173","http://localhost:3000"]

# ----------------------------------------
# IoT & External Integrations
# ----------------------------------------
# Device Secret used for ESP32 and Mock Simulator Authentication
IOT_DEVICE_SECRET=secret123

# ThingSpeak Integration (Optional Fallback)
THINGSPEAK_CHANNEL_ID=your_thingspeak_channel_id
THINGSPEAK_READ_API_KEY=your_thingspeak_read_api_key

# ----------------------------------------
# Frontend Environment Variables
# ----------------------------------------
# API URL for Vite Frontend
VITE_API_URL=http://localhost:8000/api/v1
